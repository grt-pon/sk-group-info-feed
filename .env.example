# Claude(要約・分類)
ANTHROPIC_API_KEY=

# Tavily(キーワード監視・検索)
TAVILY_API_KEY=

# 古紙ジャーナル(有料会員サイト kosijnl.co.jp のログイン情報。契約しているアカウントのIDとパスワード)
KOSIJNL_USERNAME=
KOSIJNL_PASSWORD=

# フィードバックへの返信を受け付けるための合言葉(本格的なログインではない簡易的な歯止め)
FEEDBACK_REPLY_PASSWORD=

# 保存先(以下の優先順位で自動選択。src/lib/store.js): Supabase > Firestore > ローカルファイル(data/items.json)

# Supabase(他の人も見られる共有DB。今回のプロジェクトはこちらを使う)
# SUPABASE_URLとSUPABASE_SERVICE_ROLE_KEYは、SupabaseプロジェクトのSettings > API に表示されている
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Firestore(Supabase未設定時の代替。サービスアカウントの鍵ファイルを credentials/ に置き、そのファイル名を指定する)
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./credentials/firestore-service-account.json
